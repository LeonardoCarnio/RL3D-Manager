# Credenciais do aplicativo criado no Mercado Livre Developers
ML_CLIENT_ID=SEU_APP_ID
ML_CLIENT_SECRET=SEU_CLIENT_SECRET
# Deve ser HTTPS em produção e idêntica à cadastrada no DevCenter
ML_REDIRECT_URI=https://SEU-DOMINIO.com/auth/callback
# Gere uma chave aleatória de 32 bytes em hexadecimal: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=COLOQUE_64_CARACTERES_HEXADECIMAIS
PORT=3000
NODE_ENV=production
